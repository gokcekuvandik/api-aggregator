<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage collection settings: source-generated code is not ours to test. -->
<Configuration>
  <CodeCoverage>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\/]obj[\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
