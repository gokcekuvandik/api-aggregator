{
  "openapi": "3.2.0",
  "info": {
    "title": "Aggregator.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "paths": {
    "/api/v1/aggregation": {
      "get": {
        "tags": [
          "Aggregator"
        ],
        "summary": "Aggregated items from all sources",
        "description": "Fans out to the selected sources, then filters, sorts and pages the merged items. q and city are passed to the sources that support them; category and the inclusive from/to range are applied to every item. Relevance is a 0–1 heuristic normalised per source. Returns 200 when at least one source produced data, including cached or fallback data, so a 200 can still list failed sources: read sources[] to detect degradation. Each source's answer is cached per search, so Cached and Fallback entries give the data's age in ageSeconds. Returns 400 for invalid parameters, including unknown sources or categories, and 503 when every source failed.",
        "operationId": "GetAggregation",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "maxLength": 200,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "sources",
            "in": "query",
            "schema": {
              "maxLength": 200,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "One of: relevance, date, source. Defaults to relevance.",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "One of: desc, asc. Defaults to desc.",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/aggregation/stream": {
      "get": {
        "tags": [
          "Aggregator"
        ],
        "summary": "Aggregated items streamed per source",
        "description": "Streams server-sent events: one 'source' event per selected source as soon as it completes, fastest first, with that source's filtered and sorted items (not paged), then one 'done' event. Returns 400 for invalid parameters before the stream starts; once streaming, hasData in 'done' takes the place of the 503. A stream that ends without 'done' was cut short by an error and is incomplete.",
        "operationId": "GetAggregationStream",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "maxLength": 200,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "sources",
            "in": "query",
            "schema": {
              "maxLength": 200,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "One of: relevance, date, source. Defaults to relevance.",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "One of: desc, asc. Defaults to desc.",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "required": [
                    "data"
                  ],
                  "type": "object",
                  "properties": {
                    "data": {},
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "tags": [
          "Aggregator"
        ],
        "summary": "The registered data sources and their categories",
        "operationId": "GetSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/statistics": {
      "get": {
        "tags": [
          "Aggregator"
        ],
        "summary": "Request statistics per source",
        "operationId": "GetStatistics",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatisticsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AggregationResponse": {
        "required": [
          "items",
          "sources",
          "paging"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatusResponse"
            }
          },
          "paging": {
            "$ref": "#/components/schemas/PagingResponse"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ItemDetailsResponse": {
        "required": [
          "$type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ItemDetailsResponseWeatherDetailsResponse"
          },
          {
            "$ref": "#/components/schemas/ItemDetailsResponseNewsDetailsResponse"
          },
          {
            "$ref": "#/components/schemas/ItemDetailsResponseRepositoryDetailsResponse"
          }
        ],
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "weather": "#/components/schemas/ItemDetailsResponseWeatherDetailsResponse",
            "news": "#/components/schemas/ItemDetailsResponseNewsDetailsResponse",
            "repository": "#/components/schemas/ItemDetailsResponseRepositoryDetailsResponse"
          }
        }
      },
      "ItemDetailsResponseNewsDetailsResponse": {
        "required": [
          "author",
          "points",
          "publisher"
        ],
        "type": "object",
        "properties": {
          "$type": {
            "enum": [
              "news"
            ],
            "type": "string"
          },
          "author": {
            "type": [
              "null",
              "string"
            ]
          },
          "points": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "publisher": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ItemDetailsResponseRepositoryDetailsResponse": {
        "required": [
          "stars",
          "forks",
          "language"
        ],
        "type": "object",
        "properties": {
          "$type": {
            "enum": [
              "repository"
            ],
            "type": "string"
          },
          "stars": {
            "type": "integer",
            "format": "int32"
          },
          "forks": {
            "type": "integer",
            "format": "int32"
          },
          "language": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ItemDetailsResponseWeatherDetailsResponse": {
        "required": [
          "location",
          "minTemperature",
          "maxTemperature",
          "conditions"
        ],
        "type": "object",
        "properties": {
          "$type": {
            "enum": [
              "weather"
            ],
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "minTemperature": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "maxTemperature": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "conditions": {
            "type": "string"
          }
        }
      },
      "ItemResponse": {
        "required": [
          "id",
          "source",
          "category",
          "title",
          "summary",
          "url",
          "publishedAt",
          "relevance",
          "details"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "relevance": {
            "type": "number",
            "format": "double"
          },
          "details": {
            "$ref": "#/components/schemas/ItemDetailsResponse"
          }
        }
      },
      "PagingResponse": {
        "required": [
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SourceInfoResponse": {
        "required": [
          "name",
          "categories"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SourcesResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceInfoResponse"
            }
          }
        }
      },
      "SourceStatisticsResponse": {
        "required": [
          "source",
          "totalRequests",
          "averageMs",
          "cacheHits",
          "failures"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "totalRequests": {
            "type": "integer",
            "format": "int64"
          },
          "averageMs": {
            "type": "number",
            "format": "double"
          },
          "cacheHits": {
            "type": "integer",
            "format": "int64"
          },
          "failures": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SourceStatus": {
        "enum": [
          "Success",
          "Cached",
          "Fallback",
          "Failed"
        ]
      },
      "SourceStatusResponse": {
        "required": [
          "name",
          "status",
          "durationMs",
          "error",
          "ageSeconds",
          "provider"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          },
          "durationMs": "{scrubbed}",
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "ageSeconds": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "provider": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StatisticsResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatisticsResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Aggregator"
    }
  ]
}
