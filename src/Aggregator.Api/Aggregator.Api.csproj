<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- API keys and tokens for the keyed providers live in user secrets during development. -->
    <UserSecretsId>0c52d2d3-7501-4c19-a635-941364c0d545</UserSecretsId>
    <!-- Asp.Versioning.OpenApi needs Microsoft.OpenApi 2.x, which conflicts with AspNetCore.OpenApi 11. -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aggregator.ArchitectureTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aggregator.Domain\Aggregator.Domain.csproj" />
    <ProjectReference Include="..\Aggregator.Application\Aggregator.Application.csproj" />
    <ProjectReference Include="..\Aggregator.Infrastructure\Aggregator.Infrastructure.csproj" />
    <ProjectReference Include="..\Aggregator.ServiceDefaults\Aggregator.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
