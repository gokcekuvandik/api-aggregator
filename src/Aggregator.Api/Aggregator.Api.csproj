<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      AV0029 / AV0030 recommend Asp.Versioning.OpenApi. Its 10.x line pins Microsoft.OpenApi 2.x,
      while Microsoft.AspNetCore.OpenApi 11 needs 3.x (NU1107). The built-in generator reads the
      versioned ApiExplorer groups instead, so the warnings do not apply. Revisit when an
      Asp.Versioning.OpenApi release targets Microsoft.OpenApi 3.
    -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aggregator.Domain\Aggregator.Domain.csproj" />
    <ProjectReference Include="..\Aggregator.Application\Aggregator.Application.csproj" />
    <ProjectReference Include="..\Aggregator.Infrastructure\Aggregator.Infrastructure.csproj" />
    <ProjectReference Include="..\Aggregator.ServiceDefaults\Aggregator.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
